# =============================================================================
# dashboard-app — cấu hình nginx (TEMPLATE)
# =============================================================================
# File này KHÔNG được nginx đọc trực tiếp. Entrypoint của image nginx chính thức
# sẽ chạy envsubst để thay các biến ${...} rồi ghi ra:
#     /etc/nginx/templates/default.conf.template  ->  /etc/nginx/conf.d/default.conf
#
# Nhờ đó image dashboard không phụ thuộc cứng vào bất kỳ deployment backend nào:
# chỉ cần đổi biến môi trường BACKEND_UPSTREAM lúc `docker run` / `docker compose`.
#
# Lưu ý: envsubst chỉ thay các biến CÓ trong môi trường container. Các biến nội
# bộ của nginx ($host, $uri, $proxy_host, $remote_addr...) không bị thay.
# =============================================================================

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    # Phân giải DNS động để nginx không chết lúc khởi động nếu backend chưa lên.
    resolver 127.0.0.11 8.8.8.8 valid=30s ipv6=off;

    # Đích backend, lấy từ biến môi trường BACKEND_UPSTREAM.
    # Ví dụ: http://host.docker.internal:8000 | https://api.ten-mien.com
    set $backend_upstream ${BACKEND_UPSTREAM};

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        # $proxy_host = host:port lấy từ $backend_upstream, đúng cho cả backend
        # nội bộ docker lẫn domain thật bên ngoài.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /downloads/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
