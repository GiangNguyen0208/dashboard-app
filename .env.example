# ============================================================
# dashboard-app — biến môi trường
# Copy file này thành `.env` rồi chỉnh theo môi trường của bạn.
# File `.env` đã được gitignore, KHÔNG commit.
# ============================================================

# ------------------------------------------------------------
# 1) Docker / production (nginx trong container)
# ------------------------------------------------------------
# Đích backend mà nginx proxy `/api/` và `/downloads/` tới.
#
#   - Backend chạy bằng `docker compose up` ở repo core-be, cùng máy:
#         http://host.docker.internal:8000
#   - Backend ở máy khác hoặc domain thật:
#         https://api.ten-mien-cua-ban.com
#   - Backend nằm chung docker network với dashboard:
#         http://core-be-backend-1:8000
#
BACKEND_UPSTREAM=http://host.docker.internal:8000

# ------------------------------------------------------------
# 2) Dev local (`yarn dev` — vite chạy trực tiếp trên máy host)
# ------------------------------------------------------------
# Vite proxy `/api` và `/downloads` sang địa chỉ này.
# KHÔNG dùng `host.docker.internal` ở đây vì vite không chạy trong container.
#
VITE_API_PROXY_TARGET=http://localhost:8000
